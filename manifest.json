{
  "manifest_version": 3,
  "name": "Tab Discarder",
  "description": "Manually discard any inactive tab by title",
  "version": "1.1",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "sleep-most-recent-awakened": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Sleep the most recent eligible recently awakened tab"
    }
  },
  "options_page": "options/options.html",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "24": "icons/icon24.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
